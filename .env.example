# This file is committed to Git and is PUBLIC.
# It must only ever contain placeholders, never real values.
# Copy it to .env and fill in your own values there. .env is ignored by Git.

# Create a key at https://aistudio.google.com
GEMINI_API_KEY=PASTE_YOUR_KEY_HERE

# A Flash model name that is listed in your own AI Studio. Names change over time.
GEMINI_MODEL=PASTE_MODEL_NAME_HERE

# Port for the Go API
PORT=8080
